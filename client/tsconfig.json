{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "isolatedModules": true,
    "noEmit": true, "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "baseUrl": ".", "paths": { "@shared/*": ["../shared/*"], "@/*": ["src/*"] }
  },
  "include": ["src", "../shared", "vite.config.ts"]
}
